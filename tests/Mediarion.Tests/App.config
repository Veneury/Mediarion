<?xml version="1.0" encoding="utf-8"?>
<!--
  Only .NET Framework reads this, and it is empty because the build writes what goes in it. The
  redirects are generated from the conflicting versions in the package graph, and the generator
  needs a file to write into: without one it produces nothing and says nothing, and the stream
  tests fail on net472 and net48 with a FileLoadException naming an assembly nobody referenced
  on purpose. That is what they did the first time this suite was run rather than only built.
-->
<configuration>
  <runtime>
  </runtime>
</configuration>
