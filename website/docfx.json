{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Mediarion/Mediarion.csproj",
            "Mediarion.Extensions.DependencyInjection/Mediarion.Extensions.DependencyInjection.csproj",
            "Mediarion.Streaming/Mediarion.Streaming.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      },
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "files": [
          "icon.png"
        ],
        "src": ".."
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "Mediarion",
      "_appTitle": "Mediarion",
      "_lang": "en",
      "_appFooter": "Mediarion — MIT licensed mediator for .NET",
      "_appLogoPath": "icon.png",
      "_appFaviconPath": "icon.png",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/Veneury/Mediarion",
        "branch": "main"
      }
    },
    "fileMetadata": {
      "_lang": {
        "es/**": "es"
      }
    },
    "sitemap": {
      "baseUrl": "https://veneury.github.io/Mediarion/"
    }
  }
}
