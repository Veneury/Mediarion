<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MigrationSample</RootNamespace>
    <IsPackable>false</IsPackable>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <!--
    The source of both layers is embedded so the sample can compare them as text, not only by
    what they do. The claim being checked is that they differ by two lines.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Original/Layer.cs" />
    <EmbeddedResource Include="Migrated/Layer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Mediarion.Extensions.DependencyInjection/Mediarion.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

</Project>
