<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net472;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Mediarion</RootNamespace>
    <AssemblyName>Mediarion.Streaming</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mediarion.Streaming</PackageId>
    <Description>Streaming requests for Mediarion: one request, many responses, arriving as they are produced.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!--
    This package exists so that this reference can live here instead of in the core. IAsyncEnumerable
    is in the runtime from .NET Core 3.0 onwards, and not on netstandard2.0 or .NET Framework, where
    it comes from a package. Putting streaming in Mediarion itself would mean everyone carrying that
    package, including everyone who never streams anything.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mediarion/Mediarion.csproj" />
    <!--
      For MediarionServiceConfiguration, so a stream behaviour can be added where every other
      behaviour is added. AddMediarionStreaming is a container extension and anyone calling it
      has already called AddMediarion, so the dependency was there in practice before it was
      written down. The core package still has none.
    -->
    <ProjectReference Include="../Mediarion.Extensions.DependencyInjection/Mediarion.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
