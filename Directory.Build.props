<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      RS0026 warns about overloads with optional parameters, because adding one later can break
      a caller that was compiled against the other. The advice is about an API evolving over
      time; this one is a copy of somebody else's, fixed in the shape that makes a migration a
      change of namespace. Changing it to satisfy the rule would defeat the point of the library.
    -->
    <NoWarn>$(NoWarn);NU1902;RS0026</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Mediarion</Product>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>Mediarion contributors</Authors>
    <Copyright>Copyright (c) Mediarion contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>mediator;cqrs;messaging;mediatr-alternative;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Veneury/Mediarion</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Veneury/Mediarion</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Strong naming, because a strong-named assembly on .NET Framework can only reference other
    strong-named assemblies: without this, a signed codebase on net472 cannot use Mediarion at
    all, and .NET Framework is a target this library goes out of its way to support.

    The key is in the repository on purpose. A strong name is an identity, not a security
    boundary: anyone can strip one and re-sign with a key of their own, so keeping the private
    half secret buys nothing and costs delay signing and verification skipping for everyone who
    builds. This is what the .NET projects themselves do.
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)mediarion.snk</AssemblyOriginatorKeyFile>
    <!--
      The public half of the same key. A strong-named assembly may only open its internals to a
      friend it names together with a key, so every InternalsVisibleTo has to carry this. It is
      derived from the file beside it and changes only if that file does.
    -->
    <MediarionPublicKey></MediarionPublicKey>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
